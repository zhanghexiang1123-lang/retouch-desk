{
  "name": "retouch-desk",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1",
    "start:browser": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start.ps1 -Browser",
    "test:engine": ".venv\\Scripts\\python.exe -m unittest discover -s tests -v",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "test:workspace": "node --test tests/workspace.test.mjs",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-installer.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {}
}
